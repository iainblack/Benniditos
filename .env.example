# Copy to .env.local and fill in. Production values live in Vercel
# (`vercel env pull .env.local` once the project is linked).

# Google Maps JS API key (Maps, Places, Geocoding). Used by the delivery map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase web API key for the benniditos-menus Realtime Database (menu data).
NEXT_PUBLIC_FIREBASE_APIKEY=
